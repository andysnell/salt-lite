<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <arg name="report" value="full"/>
    <arg name="cache" value="build/phpcs"/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="spn"/>
    <ini name="memory_limit" value="-1"/>
    <file>packages/core/src</file>
    <file>packages/core/tests</file>
    <file>packages/framework/src</file>
    <file>packages/framework/tests</file>
    <file>packages/phpstan/config</file>
    <file>packages/phpstan/src</file>
    <file>packages/phpstan/tests</file>
    <file>packages/template/bin</file>
    <file>packages/template/config</file>
    <file>packages/template/database</file>
    <file>packages/template/public</file>
    <file>packages/template/src</file>
    <file>packages/template/tests</file>
    <file>packages/template/rector.php</file>
    <file>bin</file>
    <file>rector.php</file>
    <file>monorepo-builder.php</file>
    <rule ref="PhoneBurner"/>
</ruleset>
